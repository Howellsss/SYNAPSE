# Copy to .env.local for local development. On Vercel, set these under Settings → Environment
# Variables. All VITE_ values end up in the browser: never put a secret (service role key,
# LiveKit secret) here.

# Supabase project (Project Settings → API Keys). The Publishable key is preferred; the legacy
# anon key still works for everything except Edge Functions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Cache (docs/caching.md). on (default) or off.
VITE_CACHE=on
# on: log cache hits, misses and refreshes in the browser console.
VITE_CACHE_DEBUG=off
# Seconds each kind of data stays fresh (defaults shown).
VITE_CACHE_TTL_DASHBOARD=30
VITE_CACHE_TTL_CONTACTS=30
VITE_CACHE_TTL_CALENDARS=30
VITE_CACHE_TTL_SPACES=60
VITE_CACHE_TTL_FORMS=60
