{
  "rewrites": [
    {
      "source": "/e/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|Googlebot|bingbot|Applebot|Snapchat|vkShare|Viber|Line|Iframely|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/event-preview?slug=:slug*"
    },
    {
      "source": "/:slug((?!(?:e|api|assets|events|landing|dashboard|signin|signup|reset-password|contacts|calendars|forms|f|workflows|recordings|characters|ai-hub|settings|rooms|streams|meetings|webinars|conversations|media-library|workspace|workspaces|book|group|invite|join|live|check-in)$)[a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|Googlebot|bingbot|Applebot|Snapchat|vkShare|Viber|Line|Iframely|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/event-preview?slug=:slug"
    },
    {
      "source": "/:slug((?!(?:e|api|assets|events|landing|dashboard|signin|signup|reset-password|contacts|calendars|forms|f|workflows|recordings|characters|ai-hub|settings|rooms|streams|meetings|webinars|conversations|media-library|workspace|workspaces|book|group|invite|join|live|check-in)$)[a-z0-9-]+)/:type([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|Googlebot|bingbot|Applebot|Snapchat|vkShare|Viber|Line|Iframely|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/event-preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/spatial/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
